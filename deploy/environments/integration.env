# ============================================================================
# Project Aegis — INTEGRATION TESTING template (PROMPT 1.2)
#
# Posture: identical topology to local, but every dependency is REAL and
# containerized (docker compose -f deploy/compose/docker-compose.yml).
# In-memory shortcuts are forbidden so test results exercise actual wire
# protocols: IC-1..IC-6 integration suites run against this profile.
# ============================================================================

AEGIS_ENV=integration
LOG_FORMAT=json                          # parseable by CI log collectors
AEGIS_HTTP_PORT=8080

DATABASE_URL=postgres://aegis_app:dev_app_only@postgres:5432/aegis?sslmode=disable
DATABASE_READ_URL=postgres://aegis_readonly:dev_readonly_only@postgres:5432/aegis?sslmode=disable
PG_POOL_MIN=4
PG_POOL_MAX=8

REDIS_URL=rediss://:dev_redis_only@redis:6379/0?insecure_skip_verify=true
REDIS_TLS=true                           # exercise TLS path even locally

KAFKA_BROKERS=redpanda:9092
KAFKA_SASL_ENABLED=false                 # SASL exercised in staging profile
KAFKA_TOPIC_FILE_VERSIONS=file_versions
KAFKA_TOPIC_CAS_TOMBSTONES=cas-tombstones

S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
CHUNK_BUCKET=aegis-chunks
AWS_ACCESS_KEY_ID=dev_minio_root
AWS_SECRET_ACCESS_KEY=dev_minio_root_only
AWS_REGION=us-east-1

TOKEN_TTL_SECONDS=900
NONCE_TTL_SECONDS=900
SESSION_TTL_HOURS=24
GC_SAFETY_WINDOW_DAYS=7
RATE_LIMIT_RPS_PER_TENANT=1000

IN_MEMORY_STORES=false                   # HARD OFF in integration
BLOOM_FILTER_ENABLED=true                # full fast-path under test

METRICS_BIND=:9102
OTEL_EXPORTER_OTLP_ENDPOINT=
