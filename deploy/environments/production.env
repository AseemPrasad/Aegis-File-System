# ============================================================================
# Project Aegis — PRODUCTION template (PROMPT 1.2)
#
# Posture: multi-AZ, replicated, deletion-protected. Provisioned exclusively
# by Terraform (make tf-plan TF_ENV=production) with change review. All
# secret values resolve from AWS Secrets Manager / KMS at deploy time via
# the ${SM:...} resolver — this file contains ZERO literal secrets and is
# safe to track; CI gitleaks still scans it as defense in depth.
# ============================================================================

AEGIS_ENV=production
LOG_FORMAT=json                          # IC-3 structured logging contract
AEGIS_HTTP_PORT=8080

DATABASE_URL=${SM:aegis/production:db_app_write_url}
DATABASE_READ_URL=${SM:aegis/production:db_read_url}
PG_POOL_MIN=16                           # CPU_cores * 2 (prod node class)
PG_POOL_MAX=32                           # CPU_cores * 4
PG_STATEMENT_TIMEOUT_MS=2000             # hot-path guard; long ops go to ANALYTICAL pool
PG_CIRCUIT_BREAKER_LATENCY_MS=100        # contract IC-2 fast-fail threshold

REDIS_URL=rediss://:${SM:aegis/production:redis_auth}@aegis-cache-production.cache.amazonaws.com:6379/0
REDIS_TLS=true

KAFKA_BROKERS=redpanda-bootstrap.aegis.svc:9093
KAFKA_SASL_ENABLED=true
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USER=${SM:aegis/production:kafka_user}
KAFKA_SASL_PASSWORD=${SM:aegis/production:kafka_password}
KAFKA_TLS_ENABLED=true
KAFKA_TOPIC_FILE_VERSIONS=file_versions
KAFKA_TOPIC_CAS_TOMBSTONES=cas-tombstones
KAFKA_REPLICATION_FACTOR=3

S3_ENDPOINT=                             # native AWS SDK
CHUNK_BUCKET=aegis-chunks-production-${AWS_ACCOUNT_ID}
AWS_REGION=${AWS_REGION}

TOKEN_TTL_SECONDS=900                    # hard cap per SLA row 5 — DO NOT raise
NONCE_TTL_SECONDS=900
SESSION_TTL_HOURS=24                     # matches bucket AbortIncompleteMultipartUpload
GC_SAFETY_WINDOW_DAYS=7                  # invariant-grade safety window
GC_BATCH_SIZE=1000                       # ≤1000 blocks per sweep transaction
GC_MAX_DELETIONS_PER_HOUR=50000          # rate-limited tombstone consumption
RATE_LIMIT_RPS_PER_TENANT=1000           # edge-enforced (IC-1)

IN_MEMORY_STORES=false                   # MUST remain false; startup asserts this
BLOOM_FILTER_ENABLED=true
BLOOM_REBUILD_SECONDS=3600               # 1h periodic rebuild

METRICS_BIND=:9102
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc:4317

CHAOS_EXPERIMENTS_ENABLED=false          # chaos lives in staging only
HPA_MIN_REPLICAS=10                      # PROMPT 10.1 defaults
HPA_MAX_REPLICAS=100
