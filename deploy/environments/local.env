# ============================================================================
# Project Aegis — LOCAL DEVELOPMENT template (PROMPT 1.2)
#
# Posture: fastest possible inner loop. In-memory substitutes ARE allowed
# here only (IN_MEMORY_STORES=true) so algorithm work (FastCDC, HMAC) runs
# with zero infrastructure; flip to false to use the compose stack instead.
# Never used for integration tests, staging, or production.
# ============================================================================

AEGIS_ENV=local
LOG_FORMAT=text                          # human-readable during dev
AEGIS_HTTP_PORT=8080

# With IN_MEMORY_STORES=true these are ignored by the service fakes.
DATABASE_URL=postgres://aegis_app:dev_app_only@localhost:5432/aegis?sslmode=disable
DATABASE_READ_URL=postgres://aegis_readonly:dev_readonly_only@localhost:5432/aegis?sslmode=disable
PG_POOL_MIN=2
PG_POOL_MAX=8                            # CPU_cores * 4 on a 2-core dev box

REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

KAFKA_BROKERS=localhost:9092
KAFKA_SASL_ENABLED=false
KAFKA_TOPIC_FILE_VERSIONS=file_versions
KAFKA_TOPIC_CAS_TOMBSTONES=cas-tombstones

S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
CHUNK_BUCKET=aegis-chunks
AWS_ACCESS_KEY_ID=dev_minio_root
AWS_SECRET_ACCESS_KEY=dev_minio_root_only
AWS_REGION=us-east-1

TOKEN_TTL_SECONDS=900                    # keep prod parity even locally:
NONCE_TTL_SECONDS=900                    # crypto behavior must not fork
SESSION_TTL_HOURS=24
GC_SAFETY_WINDOW_DAYS=7
RATE_LIMIT_RPS_PER_TENANT=1000

IN_MEMORY_STORES=true                    # local-only convenience flag
BLOOM_FILTER_ENABLED=false               # skip Redis dependency when true+fake

METRICS_BIND=:9102
OTEL_EXPORTER_OTLP_ENDPOINT=
