# ============================================================================
# Project Aegis — STAGING template (PROMPT 1.2)
#
# Posture: production parity at reduced scale. Provisioned by Terraform
# (make tf-plan TF_ENV=staging): multi-AZ Postgres, clustered Redis with TLS,
# S3 with full lifecycle + KMS, Redpanda on EKS with SASL+TLS.
# Multi-region simulation: two regional stacks (region-a/region-b) fronted by
# global DNS; cross-region replication lag is a monitored test surface for
# RTO/RPO drills (SLA rows 7-8) before they touch production.
# ============================================================================

AEGIS_ENV=staging
LOG_FORMAT=json
AEGIS_HTTP_PORT=8080

# Injected from AWS Secrets Manager (aegis/staging/db-master) at deploy time —
# never committed. Placeholders below document the expected shape only.
DATABASE_URL=${SM:aegis/staging:db_app_write_url}
DATABASE_READ_URL=${SM:aegis/staging:db_read_url}
PG_POOL_MIN=8                            # CPU_cores * 2
PG_POOL_MAX=16                           # CPU_cores * 4 (staging node class)

REDIS_URL=rediss://:${SM:aegis/staging:redis_auth}@aegis-cache-staging.cache.amazonaws.com:6379/0
REDIS_TLS=true

KAFKA_BROKERS=redpanda-bootstrap.aegis-staging.svc:9093
KAFKA_SASL_ENABLED=true
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USER=${SM:aegis/staging:kafka_user}
KAFKA_SASL_PASSWORD=${SM:aegis/staging:kafka_password}
KAFKA_TLS_ENABLED=true
KAFKA_TOPIC_FILE_VERSIONS=file_versions
KAFKA_TOPIC_CAS_TOMBSTONES=cas-tombstones
KAFKA_REPLICATION_FACTOR=3

S3_ENDPOINT=                             # empty = native AWS SDK path
CHUNK_BUCKET=aegis-chunks-staging-${AWS_ACCOUNT_ID}
AWS_REGION=${AWS_REGION}

TOKEN_TTL_SECONDS=900
NONCE_TTL_SECONDS=900
SESSION_TTL_HOURS=24
GC_SAFETY_WINDOW_DAYS=7                  # staging may shorten to 1d via override for drill speed
RATE_LIMIT_RPS_PER_TENANT=1000

IN_MEMORY_STORES=false                   # forbidden outside local profile
BLOOM_FILTER_ENABLED=true

METRICS_BIND=:9102
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc:4317

# Chaos/drill hooks exercised in staging only.
CHAOS_EXPERIMENTS_ENABLED=true
